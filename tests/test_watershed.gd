extends SceneTree
const Model=preload("res://scripts/planet_watershed.gd")
const State=preload("res://scripts/lab_state.gd")
const Program=preload("res://scripts/planet_program.gd")
const Same=preload("res://tests/fixtures_v09.gd")
var checks=0
var failures=[]
func check(ok: bool,message: String) -> void:
	checks+=1
	if not ok: failures.append(message); push_error(message)
func run_for(m,w,first: int,last: int) -> void:
	for at in range(first,last+1): m.step(w,at)
func act(s,action: String,payload: Dictionary={}) -> String:
	return s.planet.command(s,action,payload)
func deploy(s,id: String,site: String,token: int=-1) -> void:
	act(s,"deploy",{"world_id":s.planet.worlds.active_id,"site_id":site,"recipe":id,"token":s.planet.shipment_serial if token<0 else token})
func make(s,id: String) -> void:
	var info=s.planet.recipe(id); act(s,"buy_feed",{"input":info.input}); act(s,"pack",{"recipe":id}); s.planet.tick(info.seconds)
func _initialize() -> void:
	var m=Model.new(); var base=m.fresh(); var before=base.duplicate(true)
	run_for(m,base,1,60)
	check(Same.same(base,before),"new chapter remains dormant until explicitly opened")
	var river=m.fresh("devonian",0,true); var swamp=m.fresh("carboniferous",0,true)
	check(m.valid(river,0) and m.valid(swamp,0),"both initial eras satisfy independent nutrient and fish ledgers")
	check(swamp.regions.marsh.plants>river.regions.marsh.plants and m.initial_total("carboniferous")!=m.initial_total("devonian"),"eras have explicit different starting conditions")
	var pulse=river.duplicate(true); pulse.added=60.0; pulse.regions.headwater.nutrient+=60.0
	m.step(river,1); m.step(pulse,1)
	check(is_equal_approx(pulse.regions.estuary.nutrient,river.regions.estuary.nutrient),"upstream pulse cannot teleport through two reaches in one step")
	m.step(river,2); m.step(pulse,2)
	check(pulse.regions.estuary.nutrient>river.regions.estuary.nutrient,"pulse reaches downstream on a later step")
	check(absf(m.nutrient_total(pulse)-m.initial_total(pulse.era)-60)<0.00001,"transport and biology conserve supplied nutrient equivalent")
	river=m.fresh("devonian",0,true); var cutoff=river.duplicate(true); var rescue=river.duplicate(true); var screen=river.duplicate(true)
	m.deploy(screen,"headwater","screen_station"); m.deploy(screen,"headwater","screen_cartridge")
	run_for(m,river,1,60); run_for(m,cutoff,1,60); run_for(m,rescue,1,60); run_for(m,screen,1,60)
	check(screen.regions.headwater.algae+screen.regions.headwater.detritus<river.regions.headwater.algae+river.regions.headwater.detritus,"mechanical screen visibly removes upstream particles")
	check(screen.regions.headwater.nutrient>0 and screen.regions.estuary.nutrient>=river.regions.estuary.nutrient,"clearer upstream water still passes dissolved nutrient")
	m.control(cutoff,"","source"); m.control(rescue,"","source")
	run_for(m,river,61,100); run_for(m,cutoff,61,100); run_for(m,rescue,61,100); run_for(m,screen,61,100)
	m.deploy(rescue,"estuary","oxygen_station"); m.deploy(rescue,"estuary","oxygen_cartridge")
	run_for(m,river,101,180); run_for(m,cutoff,101,180); run_for(m,rescue,101,180); run_for(m,screen,101,180)
	check(river.regions.estuary.oxygen<10 and river.regions.estuary.detritus>15,"delayed algae and detritus demand drive downstream hypoxia")
	check(river.regions.estuary.fish<1 and river.refuge>24 and is_equal_approx(river.refuge+river.dead,m.cohort_total()),"open refuge records migration and losses separately")
	check(cutoff.regions.estuary.oxygen<30 and cutoff.source>80,"source control preserves budget but cannot instantly remove old organic demand")
	check(rescue.regions.estuary.oxygen>cutoff.regions.estuary.oxygen+20 and rescue.regions.estuary.gas==0,"finite emergency oxygen buys time without nutrient destruction")
	check(screen.regions.estuary.algae>river.regions.estuary.algae and screen.regions.estuary.oxygen<10,"screen-only strategy can fail as dissolved nutrients regrow downstream algae")
	run_for(m,river,181,600); run_for(m,cutoff,181,600); run_for(m,rescue,181,600)
	check(cutoff.regions.estuary.fish>10 and cutoff.regions.estuary.benthos>0 and river.regions.estuary.benthos==0,"timely source control retains a slowly recovering bottom community")
	check(rescue.regions.estuary.benthos>cutoff.regions.estuary.benthos,"source control plus finite rescue preserves more benthic life")
	check(m.valid(JSON.parse_string(JSON.stringify(rescue)),600),"full history, ledgers and devices survive JSON roundtrip")
	check(absf(m.nutrient_total(rescue)-m.initial_total(rescue.era))<0.00001,"oxygen intervention does not change nutrient total")
	run_for(m,river,601,780)
	check(river.history.size()==120 and river.regions.estuary.benthos==0,"bounded history and no spontaneous benthic resurrection")
	var closed=m.fresh("devonian",0,true); m.control(closed,"","migration"); run_for(m,closed,1,240)
	check(closed.dead>river.dead+10 and is_equal_approx(closed.refuge,24),"closed migration route exposes trapped fish to real loss")
	check(m.valid(closed,240),"mortality remains in a closed cohort ledger")
	var harvest=m.fresh("carboniferous",0,true); m.deploy(harvest,"marsh","buffer_raft")
	var total=m.nutrient_total(harvest); m.control(harvest,"marsh","harvest_target"); m.deploy(harvest,"marsh","harvest_box")
	m.control(harvest,"marsh","harvest_target")
	check(harvest.regions.marsh.harvest.target=="plants","active harvest retains chosen target despite changing next-job preference")
	run_for(m,harvest,1,30)
	check(harvest.waste>15 and harvest.regions.marsh.harvest.is_empty(),"bounded timed harvest moves biomass into sealed waste")
	check(absf(m.nutrient_total(harvest)-total)<0.00001 and m.valid(harvest,30),"buffer inputs and harvest containers close nutrient ledger")
	var flush=m.fresh("devonian",0,true); var unflushed=flush.duplicate(true)
	m.deploy(flush,"headwater","standard_water_crate"); run_for(m,flush,1,10); run_for(m,unflushed,1,10)
	check(flush.regions.marsh.nutrient>unflushed.regions.marsh.nutrient and flush.regions.headwater.flush==20,"water crates accelerate transport instead of erasing pollution")
	var filter=m.fresh("devonian",0,true); m.deploy(filter,"headwater","screen_station"); m.deploy(filter,"headwater","screen_cartridge")
	run_for(m,filter,1,80); var trapped=filter.regions.headwater.retained
	check(trapped>0 and m.can_deploy(filter,"headwater","screen_cartridge"),"spent filter can be replaced")
	m.deploy(filter,"headwater","screen_cartridge")
	check(filter.waste==trapped and filter.regions.headwater.retained==0 and m.valid(filter,80),"old captured particles and unused energy are accounted during replacement")
	var s=State.new(); s.coins=9000; var p=s.planet
	act(s,"join"); act(s,"activate_watershed",{"era":"devonian"})
	var sample=s.product_snapshot(s._new_reactor(3,"water",0)); s.storage.add_product(sample,2); act(s,"qualify",{"batch_id":sample.id})
	for id in ["screen_station","screen_cartridge","runoff_feed","buffer_raft","harvest_box"]: make(s,id)
	check(p.products.size()==5,"new supplier recipes create distinct actual industrial products")
	var snapshot=p.serialize(); var wallet=s.coins
	deploy(s,"screen_cartridge","estuary"); deploy(s,"runoff_feed","estuary")
	check(Same.same(snapshot,p.serialize()) and s.coins==wallet,"missing equipment and invalid feed location are atomic")
	var token=p.shipment_serial; deploy(s,"screen_station","estuary",token); deploy(s,"screen_station","marsh",token)
	check(p.worlds.get_world().watershed.regions.estuary.screen and not p.worlds.get_world().watershed.regions.marsh.screen,"deployment token prevents duplicate equipment")
	deploy(s,"screen_cartridge","estuary"); deploy(s,"runoff_feed","headwater"); deploy(s,"buffer_raft","marsh"); deploy(s,"harvest_box","marsh")
	act(s,"step_world")
	check(p.products.is_empty() and p.worlds.get_world().watershed.elapsed==30,"actual stock feeds connected-world operation")
	snapshot=p.serialize(); var restored=Program.new()
	check(restored.restore(JSON.parse_string(JSON.stringify(snapshot)),s) and Same.same(restored.serialize(),snapshot),"current watershed, source budgets, waste and history restore exactly")
	restored.command(s,"step_world"); act(s,"step_world")
	check(Same.same(restored.serialize(),p.serialize()),"restored simulation continues deterministically")
	act(s,"fork",{"era":"devonian"}); deploy(s,"screen_station","headwater"); deploy(s,"screen_cartridge","headwater")
	act(s,"fork",{"era":"carboniferous"})
	check(not p.worlds.can_step_pair(),"different eras cannot masquerade as equal-start experiments")
	act(s,"reset_trial",{"era":"devonian","fresh":true})
	check(p.worlds.can_step_pair(),"same era fresh baselines can run a paired intervention")
	var career=p.worlds.get_world("home").duplicate(true); act(s,"step_pair")
	check(Same.same(career,p.worlds.get_world("home")) and s.coins==wallet and p.products.is_empty(),"paired experiments cannot mutate career stock, wallet or world")
	var legacy=JSON.parse_string(FileAccess.get_file_as_string("res://tests/fixtures/planet_v0121.json")); var migrated=Program.new()
	check(migrated.restore(legacy,s),"actual v0.12.1 material fixture migrates")
	check(not migrated.worlds.get_world("home").watershed.enabled and migrated.worlds.get_world("home").ecology.regions.fish.component.recipe=="aluminum_light","migration retains installed material and leaves new chapter dormant")
	check(migrated.worlds.can_step_pair() and migrated.products.size()==2,"legacy inventory and paired baseline identities survive upgrade")
	migrated.command(s,"select",{"world_id":"trial_a"})
	migrated.command(s,"deploy",{"world_id":"trial_a","site_id":"fish","recipe":"aluminum_light","token":migrated.shipment_serial})
	var balance=migrated.worlds.get_world().eco_allowance.aluminum_light
	migrated.command(s,"activate_watershed",{"era":"carboniferous"})
	check(migrated.worlds.get_world().eco_allowance.aluminum_light==balance and Program.new().restore(migrated.serialize(),s),"opening a new chapter retains earlier trial component budget and baseline")
	var valid=p.serialize()
	for field in ["source","waste","exported","added"]:
		var bad=valid.duplicate(true); bad.worlds.worlds[0].watershed[field]+=1
		check(not Program.new().restore(bad,s),"reject unbalanced nutrient ledger: "+field)
	var bad=valid.duplicate(true); bad.worlds.worlds[0].watershed.history[0].state.regions.estuary.nutrient+=1
	check(not Program.new().restore(bad,s),"replay records must satisfy nutrient conservation too")
	bad=valid.duplicate(true); bad.worlds.worlds[0].watershed.regions.estuary.screen_energy+=1
	check(not Program.new().restore(bad,s),"reject free filter energy")
	bad=valid.duplicate(true); bad.worlds.worlds[0].watershed.regions.marsh.erase("fish")
	check(not Program.new().restore(bad,s),"malformed region is rejected cleanly")
	var t=State.new(); t.coins=9000; act(t,"join"); act(t,"activate_watershed")
	var oxygen=t.product_snapshot(t._new_reactor(3,"oxygen",0)); t.storage.add_product(oxygen,2)
	act(t,"qualify",{"reference":"oxygen","batch_id":oxygen.id})
	act(t,"compare_materials",{"mode":"same_size"}); act(t,"compare_materials",{"mode":"same_mass"})
	for site in ["headwater","marsh","estuary"]: make(t,"oxygen_station"); deploy(t,"oxygen_station",site)
	for id in ["copper_compact","aluminum_compact","aluminum_light"]: make(t,id)
	deploy(t,"copper_compact","headwater")
	var original=t.planet.worlds.get_world().watershed.regions.headwater.component.duplicate(true)
	deploy(t,"aluminum_compact","headwater")
	check(t.planet.products.any(func(item): return Same.same(item,original)),"watershed swap returns the original manufactured serial and provenance")
	var fitting=t.planet.serialize(); deploy(t,"copper_compact","estuary"); deploy(t,"aluminum_light","marsh")
	check(Same.same(fitting,t.planet.serialize()),"new river mounts enforce weight and width without debiting stock")
	deploy(t,"copper_compact","marsh"); deploy(t,"aluminum_light","estuary")
	check(t.planet.products.is_empty() and Program.new().restore(t.planet.serialize(),t),"three installed career components participate in the global inventory ledger")
	var duplicated=t.planet.serialize(); duplicated.products.append(original)
	check(not Program.new().restore(duplicated,t),"installed watershed component cannot also exist in main storage")
	act(t,"fork"); deploy(t,"aluminum_compact","marsh"); deploy(t,"copper_light","estuary")
	check(t.planet.worlds.get_world().eco_allowance.copper_compact==3 and t.planet.worlds.get_world().eco_allowance.aluminum_light==3 and Program.new().restore(t.planet.serialize(),t),"copied river components return only to the trial budget and restore correctly")
	t.close_science()
	var path="res://saves/watershed-test.json"; s.save_game(path); var s2=State.new()
	check(s2.load_game(path) and Same.same(s2.planet.serialize(),p.serialize()),"complete island save roundtrips the new chapter")
	for suffix in ["",".bak",".tmp"]:
		if FileAccess.file_exists(path+suffix): DirAccess.remove_absolute(ProjectSettings.globalize_path(path+suffix))
	s.close_science(); s2.close_science()
	print("WATERSHED: ",checks," checks, ",failures.size()," failures"); quit(0 if failures.is_empty() else 1)
